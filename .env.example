# PostgreSQL
POLICY_MONTHLY_DB_URL=jdbc:postgresql://localhost:5432/policy_daily_agent
POLICY_MONTHLY_DB_USERNAME=opspilot
POLICY_MONTHLY_DB_PASSWORD=change-me

# AI providers
POLICY_AGENT_MODEL=none
DEEPSEEK_API_KEY=
QIANFAN_API_KEY=

# Feedback-driven multi-round search (also select multi-round in the UI/request)
POLICY_SEARCH_MULTI_ROUND_ENABLED=false
# Enables LLM material-sufficiency decisions for new multi-round tasks.
POLICY_SEARCH_SEMANTIC_FEEDBACK_ENABLED=false

# Nginx frontend port
POLICY_MONTHLY_FRONTEND_PORT=8081
